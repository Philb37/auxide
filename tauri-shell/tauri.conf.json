{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "auxide-shell",
  "version": "0.1.0",
  "identifier": "com.auxide.app",
  "build": {
    "beforeDevCommand": { "script": "pnpm dev", "cwd": "../web" },
    "beforeBuildCommand": { "script": "pnpm build", "cwd": "../web" },
    "devUrl": "http://localhost:5173",
    "frontendDist": "../web/build"
  },
  "app": {
    "windows": [
      {
        "title": "Auxide",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
