# ─────────────────────────────────────────────────────────────
# Rust (Cargo workspace: crates/*, src-tauri)
# ─────────────────────────────────────────────────────────────
# Cargo.lock is committed: the workspace ships binaries (server, Tauri app).
/target/
**/target/
**/*.rs.bk
*.pdb

# Profiling / coverage
*.profraw
*.profdata
flamegraph.svg
perf.data*
lcov.info
tarpaulin-report.html
cobertura.xml

# ─────────────────────────────────────────────────────────────
# WebAssembly (app-wasm via wasm-pack / wasm-bindgen-cli)
# ─────────────────────────────────────────────────────────────
crates/app-wasm/pkg/
web/src/lib/wasm/generated/
wasm-pack.log

# ─────────────────────────────────────────────────────────────
# Tauri 2 (src-tauri)
# ─────────────────────────────────────────────────────────────
src-tauri/target/
src-tauri/gen/schemas/
# Updater signing keys: never commit
*.key
*.key.pub.bak
src-tauri/*.key

# ─────────────────────────────────────────────────────────────
# Node / pnpm / SvelteKit / Vite (web/)
# ─────────────────────────────────────────────────────────────
node_modules/
.pnpm-store/
.pnpm-debug.log*
npm-debug.log*
yarn-debug.log*
yarn-error.log*

.svelte-kit/
web/build/
/build/
.output/
.vercel/
.netlify/
vite.config.js.timestamp-*
vite.config.ts.timestamp-*

# Tests (Vitest / Playwright)
coverage/
test-results/
playwright-report/
blob-report/
playwright/.cache/

# Storybook
storybook-static/

# ─────────────────────────────────────────────────────────────
